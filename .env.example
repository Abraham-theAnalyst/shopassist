# Copy this file to .env and replace the placeholder values.
# Never commit .env.

# Used by the db service to create the database on first start
POSTGRES_USER=shopassist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopassist

# Used by the api service. The user, password and database name must match
# the values above. The host is "db", the name of the database service.
DATABASE_URL=postgresql+psycopg://shopassist:change-me@db:5432/shopassist

# Secret used to sign login tokens. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# How long a login token stays valid, in minutes
JWT_EXPIRE_MINUTES=30
